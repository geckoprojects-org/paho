# Eclipse Fennec workspace fragment (Gradle) — additive bnd properties.
#
# Layered on top of the bndtools `workspace-minimal` base (Local + Release repositories in
# cnf/build.bnd). Publishing to Maven Central is done by Jenkins through the fennec library
# (releng/central.bnd, active when GPG_PASSPHRASE is set).

# Single source of truth for the project coordinates: gradle.properties at the workspace root.
-include: ${workspace}/gradle.properties

-library: \
	fennec,\
	fennecJacoco

# Own version line of the Gecko build, separate from upstream Paho (last upstream release 1.2.5,
# develop at 1.2.6-SNAPSHOT) and from the former org.geckoprojects.messaging v5 fork (1.2.7).
base-version: 1.3.0

# The Paho clients stay on Java 8 bytecode like upstream; bnd compiles with --release 8.
javac.source: 1.8
javac.target: 1.8
-require-bnd: "(version>=7.1.0)"
-jpms-module-info:

# Maven Central (read-only).
-plugin.5.Central: \
	aQute.bnd.repository.maven.provider.MavenBndRepository; \
		snapshotUrl="https://central.sonatype.com/repository/maven-snapshots/"; \
		releaseUrl=https://repo.maven.apache.org/maven2/; \
		index=${.}/central.mvn; \
		readOnly=true; \
		poll.time=-1; \
		name="Central"

# Project coordinates, imported from gradle.properties (single source).
github-orga:    ${github_org}
github-project: ${github_repository}
-groupid:       ${maven_group_id}
