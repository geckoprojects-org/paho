Bundle-Name: Paho MQTT v5 Client (Gecko build)
Bundle-Description: Eclipse Paho Java client for MQTT 5, built from \
	https://github.com/${github-orga}/${github-project} with automatic reconnect fixes. \
	Based on Eclipse Paho; not an official Eclipse release.
Bundle-License: \
	EPL-2.0;description="Eclipse Public License 2.0";link="https://www.eclipse.org/legal/epl-2.0/",\
	BSD-3-Clause;description="Eclipse Distribution License 1.0";link="https://www.eclipse.org/org/documents/edl-v10.php"
Bundle-Copyright: IBM Corp. and others (Eclipse Paho); Gecko build by Data In Motion Consulting GmbH
Bundle-Vendor: Data In Motion Consulting GmbH

# Paho is dual-licensed EPL-2.0 / EDL-1.0; ship its licence files instead of the fennec default.
-includeresource.license: \
	META-INF/LICENSE=${workspace}/LICENSE,\
	META-INF/NOTICE=${workspace}/NOTICE,\
	META-INF/epl-v20=${workspace}/epl-v20,\
	META-INF/edl-v10=${workspace}/edl-v10,\
	about.html=${workspace}/about.html

# ServiceLoader registration of the network modules and the message catalogues.
-includeresource.resources: src/main/resources

# The TLS packages are only needed for ssl:// and wss:// connections.
Import-Package: \
	javax.net;resolution:=optional,\
	javax.net.ssl;resolution:=optional,\
	*

src: src/main/java

# Upstream exports only org.eclipse.paho.mqttv5.client, which leaves MqttException, MqttMessage,
# MqttSubscription, MqttProperties (common, common.packet) unusable in OSGi. Export the API
# packages; internal, security, websocket and wire stay private.
Export-Package: \
	org.eclipse.paho.mqttv5.client;version=${base-version},\
	org.eclipse.paho.mqttv5.client.logging;version=${base-version},\
	org.eclipse.paho.mqttv5.client.persist;version=${base-version},\
	org.eclipse.paho.mqttv5.client.spi;version=${base-version},\
	org.eclipse.paho.mqttv5.client.util;version=${base-version},\
	org.eclipse.paho.mqttv5.common;version=${base-version},\
	org.eclipse.paho.mqttv5.common.packet;version=${base-version},\
	org.eclipse.paho.mqttv5.common.packet.util;version=${base-version},\
	org.eclipse.paho.mqttv5.common.util;version=${base-version}
-privatepackage: \
	org.eclipse.paho.mqttv5.client.internal.*,\
	org.eclipse.paho.mqttv5.client.security,\
	org.eclipse.paho.mqttv5.client.websocket,\
	org.eclipse.paho.mqttv5.client.wire
